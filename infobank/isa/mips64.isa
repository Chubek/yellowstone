encoding BEQ { width = 32;
  base = 0x10000000;
  rs1 = 21:5;
  rs2 = 16:5;
  offset[15:2] = 0:14;
  signed = 1;
  alignment = 4;
}

op beq { class = branch; encoding = BEQ;
  operands = rs1: GPR, rs2: GPR, offset: rel;
  syntax = "beq ${rs1}, ${rs2}, {offset}";
  semantics = "(if (eq rs1 rs2) (branch offset))";
}

encoding BNE { width = 32;
  base = 0x14000000;
  rs1 = 21:5;
  rs2 = 16:5;
  offset[15:2] = 0:14;
  signed = 1;
  alignment = 4;
}

op bne { class = branch; encoding = BNE;
  operands = rs1: GPR, rs2: GPR, offset: rel;
  syntax = "bne ${rs1}, ${rs2}, {offset}";
  semantics = "(if (ne rs1 rs2) (branch offset))";
}

encoding BEQL { width = 32;
  base = 0x50000000;
  rs1 = 21:5;
  rs2 = 16:5;
  offset[15:2] = 0:14;
  signed = 1;
  alignment = 4;
}

op beql { class = branch; encoding = BEQL;
  operands = rs1: GPR, rs2: GPR, offset: rel;
  syntax = "beql ${rs1}, ${rs2}, {offset}";
  semantics = "(effect (branch \"beql\" rs1 rs2 offset))";
}

encoding BNEL { width = 32;
