alias fp = x29;
alias lr = x30;

encoding A_ADD { width = 32;
  base = 0x8b000000;
  rd = 0:5;
  rs1 = 5:5;
  rs2 = 16:5;
}

op add { class = arithmetic; encoding = A_ADD;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "add {rd}, {rs1}, {rs2}";
  semantics = "(set rd (add rs1 rs2))";
}

encoding A_ADD_SHIFT { width = 32;
  base = 0x8b000000;
  rd = 0:5;
  rs1 = 5:5;
  rs2 = 16:5;
  imm = 10:6;
}

op add_shift { class = arithmetic; encoding = A_ADD_SHIFT;
  operands = rd: GPR, rs1: GPR, rs2: GPR, imm: imm;
  syntax = "add {rd}, {rs1}, {rs2}, lsl #{imm}";
  semantics = "(set rd (add rs1 rs2 imm))";
}

encoding A_ADD_EXT { width = 32;
  base = 0x8b206000;
  rd = 0:5;
  rs1 = 5:5;
  rs2 = 16:5;
  imm = 10:3;
}

op add_ext { class = arithmetic; encoding = A_ADD_EXT;
  operands = rd: GPR, rs1: GPR, rs2: GPR, imm: imm;
  syntax = "add {rd}, {rs1}, {rs2}, uxtx #{imm}";
  semantics = "(set rd (add rs1 rs2 imm))";
}

