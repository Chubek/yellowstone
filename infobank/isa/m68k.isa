  rd = 9:3;
  mode = 3:3;
  reg = 0:3;
}

op divs_l { class = arithmetic; encoding = DIVS_L;
  operands = rd: GPR, mode: imm, reg: GPR;
  syntax = "divs.l ${reg} [{mode}], ${rd}";
  semantics = "(set rd (div mode reg))";
}

