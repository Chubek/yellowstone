encoding LG { width = 48;
  base = 0xe30000000004;
  rt = 36:4;
  rs2 = 32:4;
  rb = 28:4;
  offset[11:8] = 24:4;
  offset[3:0] = 16:4;
  offset[7:4] = 20:4;
  signed = 1;
}

op lg { class = load; encoding = LG;
  operands = rt: GPR, rs2: GPR, rb: GPR, offset: imm;
  syntax = "lg %{rt}, {offset}(%{rs2}, %{rb})";
  semantics = "(effect (load \"lg\" rt rs2 rb offset))";
}

