op lhi { class = load; encoding = LHI;
  operands = rd: GPR, imm: imm;
  syntax = "lhi %{rd}, {imm}";
  semantics = "(set rd (load target (addr imm)))";
}

encoding LGHI { width = 32;
  base = 0xa7090000;
  rd = 20:4;
  imm = 0:16;
  signed = 1;
}

op lghi { class = load; encoding = LGHI;
  operands = rd: GPR, imm: imm;
  syntax = "lghi %{rd}, {imm}";
  semantics = "(set rd (load target (addr imm)))";
}

encoding AGHI { width = 32;
  base = 0xa70b0000;
  rd = 20:4;
  imm = 0:16;
  signed = 1;
}

op aghi { class = arithmetic; encoding = AGHI;
  operands = rd: GPR, imm: imm;
  syntax = "aghi %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"aghi\" imm))";
}

encoding CHI { width = 32;
  base = 0xa70e0000;
  rd = 20:4;
  imm = 0:16;
  signed = 1;
}

op chi { class = compare; encoding = CHI;
  operands = rd: GPR, imm: imm;
  syntax = "chi %{rd}, {imm}";
  semantics = "(set rd (compare imm))";
}

encoding CGHI { width = 32;
  base = 0xa70f0000;
  rd = 20:4;
  imm = 0:16;
  signed = 1;
}

op cghi { class = compare; encoding = CGHI;
  operands = rd: GPR, imm: imm;
  syntax = "cghi %{rd}, {imm}";
  semantics = "(set rd (compare imm))";
}

encoding NILL { width = 32;
  base = 0xa5070000;
  rd = 20:4;
  imm = 0:16;
  signed = 1;
}

op nill { class = arithmetic; encoding = NILL;
  operands = rd: GPR, imm: imm;
  syntax = "nill %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"nill\" imm))";
}

encoding OILL { width = 32;
  base = 0xa50b0000;
  rd = 20:4;
  imm = 0:16;
  signed = 1;
}

op oill { class = arithmetic; encoding = OILL;
  operands = rd: GPR, imm: imm;
  syntax = "oill %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"oill\" imm))";
}

encoding CLFI { width = 48;
  base = 0xc20f00000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op clfi { class = compare; encoding = CLFI;
  operands = rd: GPR, imm: imm;
  syntax = "clfi %{rd}, {imm}";
  semantics = "(set rd (compare imm))";
}

encoding CLGFI { width = 48;
  base = 0xc20e00000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op clgfi { class = compare; encoding = CLGFI;
  operands = rd: GPR, imm: imm;
  syntax = "clgfi %{rd}, {imm}";
  semantics = "(set rd (compare imm))";
}

encoding AGFI { width = 48;
  base = 0xc20800000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op agfi { class = arithmetic; encoding = AGFI;
  operands = rd: GPR, imm: imm;
  syntax = "agfi %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"agfi\" imm))";
}

encoding XILF { width = 48;
  base = 0xc00700000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op xilf { class = arithmetic; encoding = XILF;
  operands = rd: GPR, imm: imm;
  syntax = "xilf %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"xilf\" imm))";
}

encoding OILF { width = 48;
  base = 0xc00d00000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op oilf { class = arithmetic; encoding = OILF;
  operands = rd: GPR, imm: imm;
  syntax = "oilf %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"oilf\" imm))";
}

encoding IILF { width = 48;
  base = 0xc00900000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op iilf { class = arithmetic; encoding = IILF;
  operands = rd: GPR, imm: imm;
  syntax = "iilf %{rd}, {imm}";
  semantics = "(set rd (intrinsic \"iilf\" imm))";
}

encoding LLIHF { width = 48;
  base = 0xc00e00000000;
  rd = 36:4;
  imm = 0:32;
  signed = 1;
}

op llihf { class = load; encoding = LLIHF;
  operands = rd: GPR, imm: imm;
  syntax = "llihf %{rd}, {imm}";
  semantics = "(set rd (load target (addr imm)))";
}

encoding B { width = 32;
  base = 0x47f00000;
  offset = 0:16;
  signed = 1;
}

op b { class = branch; encoding = B;
  operands = offset: rel;
  syntax = "b {offset}";
  semantics = "(branch offset)";
}

encoding BR { width = 16;
  base = 0x7f0;
  rs1 = 0:4;
}

op br { class = branch; encoding = BR;
  operands = rs1: GPR;
  syntax = "br %{rs1}";
  semantics = "(branch rs1)";
}

encoding NOPR { width = 16;
  base = 0x700;
  rs1 = 0:4;
}

op nopr { class = misc; encoding = NOPR;
  operands = rs1: GPR;
  syntax = "nopr %{rs1}";
  semantics = "(effect (intrinsic \"nopr\" rs1))";
}
