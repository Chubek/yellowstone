    f29(64)=29,
    f30(64)=30,
    f31(64)=31,
    fcc0(64)=0,
    fcc1(64)=1,
    fcc2(64)=2,
    fcc3(64)=3,
    fcc4(64)=4,
    fcc5(64)=5,
    fcc6(64)=6,
    fcc7(64)=7,
}

encoding ADD_W { width = 32;
  base = 0x100000;
  rd = 0:5;
  rs1 = 5:5;
  rs2 = 10:5;
}

op add_w { class = arithmetic; encoding = ADD_W;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "add.w ${rd}, ${rs1}, ${rs2}";
  semantics = "(set rd (add rs1 rs2))";
}

