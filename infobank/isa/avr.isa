encoding BRHC { width = 16;
  base = 0xf405;
  offset[7:1] = 3:7;
  signed = 1;
  alignment = 2;
}

op brhc { class = branch; encoding = BRHC;
  operands = offset: rel;
  syntax = "brhc {offset}";
  semantics = "(effect (branch \"brhc\" offset))";
}

