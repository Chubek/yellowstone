alias t6 = x31;

encoding E_LUI { width = 32;
  base = 0x37;
  rd = 7:5;
  upper = 12:20;
}

op lui { class = misc; encoding = E_LUI;
  operands = rd: GPR, upper: imm;
  syntax = "lui {rd}, {upper}";
  semantics = "(set rd (move upper))";
}

encoding E_AUIPC { width = 32;
  base = 0x17;
  rd = 7:5;
  upper = 12:20;
}

op auipc { class = misc; encoding = E_AUIPC;
  operands = rd: GPR, upper: imm;
  syntax = "auipc {rd}, {upper}";
  semantics = "(set rd (move upper))";
}

encoding E_JAL { width = 32;
  base = 0x6f;
  rd = 7:5;
  offset[19:12] = 12:8;
  offset[11:11] = 20:1;
  offset[10:1] = 21:10;
  offset[20:20] = 31:1;
  alignment = 2;
  signed = 1;
}

op jal { class = branch; encoding = E_JAL;
  operands = rd: GPR, offset: rel;
  syntax = "jal {rd}, {offset}";
  semantics = "(sequence (set rd (pc+4)) (branch offset))";
}

encoding E_JALR { width = 32;
  base = 0x67;
  rd = 7:5;
  rs1 = 15:5;
  imm = 20:12;
  signed = 1;
}

op jalr { class = branch; encoding = E_JALR;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "jalr {rd}, {imm}({rs1})";
  semantics = "(sequence (set rd (pc+4)) (branch (add rs1 imm)))";
}

encoding E_BEQ { width = 32;
  base = 0x63;
  offset[12:12] = 31:1;
  offset[10:5] = 25:6;
  rs2 = 20:5;
  rs1 = 15:5;
  offset[4:1] = 8:4;
  offset[11:11] = 7:1;
  alignment = 2;
  signed = 1;
}

op beq { class = branch; encoding = E_BEQ;
  operands = rs1: GPR, rs2: GPR, offset: rel;
  syntax = "beq {rs1}, {rs2}, {offset}";
  semantics = "(if (eq rs1 rs2) (branch offset))";
}

encoding E_BNE { width = 32;
  base = 0x1063;
  offset[12:12] = 31:1;
  offset[10:5] = 25:6;
  rs2 = 20:5;
