arch wasm { word_size = 32; addr_size = 32; endian = little; align = 1; }


profile {
  family = "WebAssembly";
  model = "Core";
  version = "2_0";
  word_size = 32;
  address_size = 32;
  endianness = "little";
  instruction_encoding = "variable_bytecode";
  execution_model = "stack_machine";
  register_model = "operand_stack_and_locals";
  extensions = ["MVP", "bulk_memory", "reference_types", "multi_value", "tail_call_target_dependent", "SIMD_target_dependent"];
  register_classes = [];
  fixed_registers = [];
  zero_register = "none";
  operation_classes = ["arithmetic", "branch", "compare", "convert", "load", "misc", "store"];
  instruction_count = 200;
  encoding_widths = ["stream"];
  coverage = "source_inventory";
  encoding_layout = { opcode = "LEB_or_byte_sequence"; immediates = "LEB128_or_fixed"; };
}
compiler {
  instruction_selection {
    strategy = "ssa_or_stack_pattern_matching";
    opcode_classes = ["arithmetic", "branch", "compare", "convert", "load", "misc", "store"];
    register_classes = [];
    immediate_folding = true;
    addressing_mode_folding = true;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "IR_dependency_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = true;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = false;
  }
  register_allocation {
    strategy = "none_physical_register_allocation";
    register_classes = [];
    fixed_registers = [];
    zero_register = "none";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "addressing_mode_folding", "branch_relaxation_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
encoding W_UNREACHABLE { width = stream;
  base = 0x0;
  sequence = byte(0x0);
}

op unreachable { class = branch; encoding = W_UNREACHABLE;
  operands = ;
  syntax = "unreachable";
  semantics = "(trap)";
}

encoding W_NOP { width = stream;
  base = 0x0;
  sequence = byte(0x1);
}

op nop { class = misc; encoding = W_NOP;
  operands = ;
  syntax = "nop";
  semantics = "(control \"nop\")";
}

encoding W_BLOCK { width = stream;
  base = 0x0;
  sequence = byte(0x2),sleb(bt);
}

op block { class = branch; encoding = W_BLOCK;
  operands = bt: imm;
  syntax = "block (result {bt})";
  semantics = "(control \"block\" bt)";
}

encoding W_LOOP { width = stream;
  base = 0x0;
  sequence = byte(0x3),sleb(bt);
}

op loop { class = branch; encoding = W_LOOP;
  operands = bt: imm;
  syntax = "loop (result {bt})";
  semantics = "(control \"loop\" bt)";
}

encoding W_IF { width = stream;
  base = 0x0;
  sequence = byte(0x4),sleb(bt);
}

op if { class = branch; encoding = W_IF;
  operands = bt: imm;
  syntax = "if (result {bt})";
  semantics = "(control \"if\" bt)";
}

encoding W_ELSE { width = stream;
  base = 0x0;
  sequence = byte(0x5);
}

op else { class = branch; encoding = W_ELSE;
  operands = ;
  syntax = "else";
  semantics = "(control \"else\")";
}

encoding W_END { width = stream;
  base = 0x0;
  sequence = byte(0xb);
}

op end { class = branch; encoding = W_END;
  operands = ;
  syntax = "end";
  semantics = "(control \"end\")";
}

encoding W_BR { width = stream;
  base = 0x0;
  sequence = byte(0xc),uleb(depth);
  leb_bits = 32;
}

op br { class = branch; encoding = W_BR;
  operands = depth: imm;
  syntax = "br {depth}";
  semantics = "(control \"br\" depth)";
}

encoding W_BR_IF { width = stream;
  base = 0x0;
  sequence = byte(0xd),uleb(depth);
  leb_bits = 32;
}

op br_if { class = branch; encoding = W_BR_IF;
  operands = depth: imm;
  syntax = "br_if {depth}";
  semantics = "(control \"br_if\" depth)";
}

encoding W_BR_TABLE { width = stream;
  base = 0x0;
  sequence = byte(0xe),uleb(count),uleb(targets),uleb(default);
  leb_bits = 32;
}

op br_table { class = branch; encoding = W_BR_TABLE;
  operands = count: imm, targets: imm, default: imm;
  syntax = "br_table {count}, {targets}, {default}";
  semantics = "(control \"br_table\" count targets default)";
}

encoding W_RETURN { width = stream;
  base = 0x0;
  sequence = byte(0xf);
}

op return { class = branch; encoding = W_RETURN;
  operands = ;
  syntax = "return";
  semantics = "(control \"return\" )";
}

encoding W_CALL { width = stream;
  base = 0x0;
  sequence = byte(0x10),uleb(func);
  leb_bits = 32;
}

op call { class = branch; encoding = W_CALL;
  operands = func: imm;
  syntax = "call {func}";
  semantics = "(control \"call\" func)";
}

encoding W_CALL_INDIRECT { width = stream;
  base = 0x0;
  sequence = byte(0x11),uleb(type),uleb(table);
  leb_bits = 32;
}

op call_indirect { class = branch; encoding = W_CALL_INDIRECT;
  operands = type: imm, table: imm;
  syntax = "call_indirect {type}, {table}";
  semantics = "(control \"call_indirect\" type table)";
}

encoding W_DROP { width = stream;
  base = 0x0;
  sequence = byte(0x1a);
}

op drop { class = misc; encoding = W_DROP;
  operands = ;
  syntax = "drop";
  semantics = "(stack (intrinsic \"drop\" ))";
}

encoding W_SELECT { width = stream;
