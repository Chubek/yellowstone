encoding NOP { width = 32;
  base = 0x3400000;
}

op nop { class = system; encoding = NOP;
  operands = ;
  syntax = "nop";
}

encoding BREAK { width = 32;
  base = 0x2a0000;
  code = 0:15;
}

op break { class = system; encoding = BREAK;
  operands = code: imm;
