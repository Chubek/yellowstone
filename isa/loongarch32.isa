# LoongArch little endian. Mnemonic dots are written with underscores in operation
# names, so add.w is the operation add_w while its syntax still reads add.w.
# Fields are instruction bit positions: the destination at 0:5, the first source at
# 5:10, the second at 10:15 and a fourth at 15:20.  A twelve bit immediate, a
# shift amount and a twelve bit displacement each take the third field.
# The two-register branches put the second register at 0:5 and store a
# sixteen bit displacement in words at 10:26; the unconditional branches
# split their twenty six bit word displacement either side of the opcode,
# so b and bl take it as two operands, written high half first.  A target
# within 128 MiB needs only the low half, which is the offset operand.
arch loongarch32 { word_size = 32; addr_size = 32; endian = little; align = 4; }

regclass GPR {
    r0(32)=0,
    r1(32)=1,
    r2(32)=2,
    r3(32)=3,
    r4(32)=4,
    r5(32)=5,
    r6(32)=6,
    r7(32)=7,
    r8(32)=8,
    r9(32)=9,
    r10(32)=10,
    r11(32)=11,
    r12(32)=12,
    r13(32)=13,
    r14(32)=14,
    r15(32)=15,
    r16(32)=16,
    r17(32)=17,
    r18(32)=18,
    r19(32)=19,
    r20(32)=20,
    r21(32)=21,
    r22(32)=22,
    r23(32)=23,
    r24(32)=24,
    r25(32)=25,
    r26(32)=26,
    r27(32)=27,
    r28(32)=28,
    r29(32)=29,
    r30(32)=30,
    r31(32)=31,
}

regclass FPR {
    f0(64)=0,
    f1(64)=1,
    f2(64)=2,
    f3(64)=3,
    f4(64)=4,
    f5(64)=5,
    f6(64)=6,
    f7(64)=7,
    f8(64)=8,
    f9(64)=9,
    f10(64)=10,
    f11(64)=11,
    f12(64)=12,
    f13(64)=13,
    f14(64)=14,
    f15(64)=15,
    f16(64)=16,
    f17(64)=17,
    f18(64)=18,
    f19(64)=19,
    f20(64)=20,
    f21(64)=21,
    f22(64)=22,
    f23(64)=23,
    f24(64)=24,
    f25(64)=25,
    f26(64)=26,
    f27(64)=27,
    f28(64)=28,
    f29(64)=29,
    f30(64)=30,
    f31(64)=31,
    fcc0(64)=0,
    fcc1(64)=1,
    fcc2(64)=2,
    fcc3(64)=3,
    fcc4(64)=4,
    fcc5(64)=5,
    fcc6(64)=6,
    fcc7(64)=7,
}



encoding ADD_W { width = 32;
  base = 0x100000;
  rd = 0:5;
  rs1 = 5:5;
  rs2 = 10:5;
}

op add_w { class = arithmetic; encoding = ADD_W;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "add.w ${rd}, ${rs1}, ${rs2}";
}

