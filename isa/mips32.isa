# MIPS32 release 2 and later, big endian. This file keeps the register
# numbering the bundled source used, which puts t0 to t7 at 8 to 15 rather
# than the architecture's 12 to 19; mips64.isa uses the real numbering.
# Fields are
# instruction bit positions: the six bit opcode at 0:6.  A three-register
# ALU instruction puts its destination at 11:16, its first source at 21:26
# and its second at 16:21; the immediate, load and store forms put the
# destination at 16:21; the shifts put it at 11:16 as well.
arch mips32 { word_size = 32; addr_size = 32; endian = big; align = 4; }

regclass GPR {
    zero(32)=0,
    at(32)=1,
    v0(32)=2,
    v1(32)=3,
    a0(32)=4,
    a1(32)=5,
    a2(32)=6,
    a3(32)=7,
    a4(32)=8,
    a5(32)=9,
    a6(32)=10,
    a7(32)=11,
    t0(32)=8,
    t1(32)=9,
    t2(32)=10,
    t3(32)=11,
    s0(32)=16,
    s1(32)=17,
    s2(32)=18,
    s3(32)=19,
    s4(32)=20,
    s5(32)=21,
    s6(32)=22,
    s7(32)=23,
    t8(32)=24,
    t9(32)=25,
    k0(32)=26,
    k1(32)=27,
    gp(32)=28,
    sp(32)=29,
    fp(32)=30,
    ra(32)=31,
}

regclass FPR {
    f0(32)=0,
    f1(32)=1,
    f2(32)=2,
    f3(32)=3,
    f4(32)=4,
    f5(32)=5,
    f6(32)=6,
    f7(32)=7,
    f8(32)=8,
    f9(32)=9,
    f10(32)=10,
    f11(32)=11,
    f12(32)=12,
    f13(32)=13,
    f14(32)=14,
    f15(32)=15,
    f16(32)=16,
    f17(32)=17,
    f18(32)=18,
    f19(32)=19,
    f20(32)=20,
    f21(32)=21,
    f22(32)=22,
    f23(32)=23,
    f24(32)=24,
    f25(32)=25,
    f26(32)=26,
    f27(32)=27,
    f28(32)=28,
    f29(32)=29,
    f30(32)=30,
    f31(32)=31,
}

alias s8 = fp;



encoding ADDU { width = 32;
  base = 0x21;
  rd = 11:5;
  rs1 = 21:5;
  rs2 = 16:5;
}

op addu { class = arithmetic; encoding = ADDU;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "addu ${rd}, ${rs1}, ${rs2}";
}

encoding ADD { width = 32;
  base = 0x20;
  rd = 11:5;
  rs1 = 21:5;
  rs2 = 16:5;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "add ${rd}, ${rs1}, ${rs2}";
}

