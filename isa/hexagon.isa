# Hexagon, little endian, 32-bit instructions in the register-assignment spelling
# the assembler uses, so an operation reads "rd = op(rs, rt)".  This llvm-mc build
# assembles the base integer group under the default target, and every base is
# measured with it.
# The destination sits at 0:5.  The two source fields swap order from one
# operation to the next: add, and, or, xor, max, round and the register shifts put
# the first source at 16:5 and the second at 8:5, while sub and min put the first
# at 8:5 and the second at 16:5.  The generator measures each operation's own
# source order rather than assume one.
# An arithmetic immediate is eight signed bits at 5:8 and a shift amount is six
# bits at 8:6, with the shift type's marker in the base.  The predicate group
# reads its three registers from the two-bit fields at 0:2, 8:2 and 16:2, and the
# loop instructions store a seven-bit count at 3:7 beside the register at 16:5.
# Not listed, with the reason: the floating point, vector and memory groups, which
# this llvm-mc build's default Hexagon target does not accept; the predicate group,
# whose p0 to p3 registers are a separate register file the format has no class
# for; and the branch and call instructions, which this assembler only spells
# against a symbol rather than a number.
arch hexagon { word_size = 32; addr_size = 32; endian = little; align = 4; }

regclass GPR {
    r0(32)=0,
    r1(32)=1,
    r2(32)=2,
    r3(32)=3,
    r4(32)=4,
    r5(32)=5,
    r6(32)=6,
    r7(32)=7,
    r8(32)=8,
    r9(32)=9,
    r10(32)=10,
    r11(32)=11,
    r12(32)=12,
    r13(32)=13,
    r14(32)=14,
    r15(32)=15,
    r16(32)=16,
    r17(32)=17,
    r18(32)=18,
    r19(32)=19,
    r20(32)=20,
    r21(32)=21,
    r22(32)=22,
    r23(32)=23,
    r24(32)=24,
    r25(32)=25,
    r26(32)=26,
    r27(32)=27,
    r28(32)=28,
    r29(32)=29,
    r30(32)=30,
    r31(32)=31,
}

alias g0 = r4;
alias g1 = r5;
alias g2 = r6;



encoding ADD { width = 32;
  base = 0xf300c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = add({rs1}, {rs2})";
}

encoding SUB { width = 32;
  base = 0xf320c000;
  rd = 0:5;
  rs1 = 8:5;
  rs2 = 16:5;
}

op sub { class = arithmetic; encoding = SUB;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = sub({rs1}, {rs2})";
}

encoding AND { width = 32;
  base = 0xf100c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op and { class = arithmetic; encoding = AND;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = and({rs1}, {rs2})";
}

encoding OR { width = 32;
  base = 0xf120c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op or { class = arithmetic; encoding = OR;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = or({rs1}, {rs2})";
}

encoding XOR { width = 32;
  base = 0xf160c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op xor { class = arithmetic; encoding = XOR;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = xor({rs1}, {rs2})";
}

encoding MIN { width = 32;
  base = 0xd5a0c000;
  rd = 0:5;
  rs1 = 8:5;
  rs2 = 16:5;
}

op min { class = arithmetic; encoding = MIN;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = min({rs1}, {rs2})";
}

encoding MAX { width = 32;
  base = 0xd5c0c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op max { class = arithmetic; encoding = MAX;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = max({rs1}, {rs2})";
}

encoding ROUND { width = 32;
  base = 0xc6c0c080;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op round { class = arithmetic; encoding = ROUND;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = round({rs1}, {rs2})";
}

encoding ASL { width = 32;
  base = 0xc640c080;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op asl { class = arithmetic; encoding = ASL;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = asl({rs1}, {rs2})";
}

encoding ASR { width = 32;
  base = 0xc640c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op asr { class = arithmetic; encoding = ASR;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = asr({rs1}, {rs2})";
}

encoding LSR { width = 32;
  base = 0xc640c040;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op lsr { class = arithmetic; encoding = LSR;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = lsr({rs1}, {rs2})";
}

encoding ADD_IMM { width = 32;
  base = 0xb000c000;
  rd = 0:5;
  rs1 = 16:5;
  imm = 5:8;
  signed = 1;
}

op add_imm { class = arithmetic; encoding = ADD_IMM;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "{rd} = add({rs1}, #{imm})";
}

encoding AND_IMM { width = 32;
  base = 0x7600c000;
  rd = 0:5;
  rs1 = 16:5;
  imm = 5:8;
  signed = 1;
}

op and_imm { class = arithmetic; encoding = AND_IMM;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "{rd} = and({rs1}, #{imm})";
}

encoding OR_IMM { width = 32;
  base = 0x7680c000;
  rd = 0:5;
  rs1 = 16:5;
  imm = 5:8;
  signed = 1;
}

op or_imm { class = arithmetic; encoding = OR_IMM;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "{rd} = or({rs1}, #{imm})";
}

encoding ASL_IMM { width = 32;
  base = 0x8c00c040;
  rd = 0:5;
  rs1 = 16:5;
  imm = 8:6;
  signed = 1;
}

op asl_imm { class = arithmetic; encoding = ASL_IMM;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "{rd} = asl({rs1}, #{imm})";
}

encoding ASR_IMM { width = 32;
  base = 0x8c00c000;
  rd = 0:5;
  rs1 = 16:5;
  imm = 8:6;
  signed = 1;
}

op asr_imm { class = arithmetic; encoding = ASR_IMM;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "{rd} = asr({rs1}, #{imm})";
}

encoding LSR_IMM { width = 32;
  base = 0x8c00c020;
  rd = 0:5;
  rs1 = 16:5;
  imm = 8:6;
  signed = 1;
}

op lsr_imm { class = arithmetic; encoding = LSR_IMM;
  operands = rd: GPR, rs1: GPR, imm: imm;
  syntax = "{rd} = lsr({rs1}, #{imm})";
}

encoding MOV { width = 32;
  base = 0x7060c000;
  rd = 0:5;
  rs1 = 16:5;
}

op mov { class = misc; encoding = MOV;
  operands = rd: GPR, rs1: GPR;
  syntax = "{rd} = {rs1}";
}

encoding MOV_IMM { width = 32;
  base = 0x7800c000;
  rd = 0:5;
  imm = 5:8;
  signed = 1;
}

op mov_imm { class = misc; encoding = MOV_IMM;
  operands = rd: GPR, imm: imm;
  syntax = "{rd} = #{imm}";
}

encoding BREV { width = 32;
  base = 0x8c40c0c0;
  rd = 0:5;
  rs1 = 16:5;
}

op brev { class = misc; encoding = BREV;
  operands = rd: GPR, rs1: GPR;
  syntax = "{rd} = brev({rs1})";
}

encoding NOP { width = 32;
  base = 0x7f00c000;
}

op nop { class = misc; encoding = NOP;
  operands = ;
  syntax = "nop";
}

encoding LOOP0 { width = 32;
  base = 0x6000c000;
  imm = 3:7;
  rs1 = 16:5;
  signed = 1;
}

op loop0 { class = branch; encoding = LOOP0;
  operands = imm: imm, rs1: GPR;
  syntax = "loop0(#{imm}, {rs1})";
}

encoding LOOP1 { width = 32;
  base = 0x6020c000;
  imm = 3:7;
  rs1 = 16:5;
  signed = 1;
}

op loop1 { class = branch; encoding = LOOP1;
  operands = imm: imm, rs1: GPR;
  syntax = "loop1(#{imm}, {rs1})";
}

encoding JUMPR { width = 32;
  base = 0x5280c000;
  rs1 = 16:5;
}

op jumpr { class = branch; encoding = JUMPR;
  operands = rs1: GPR;
  syntax = "jumpr {rs1}";
}

encoding G_TO_R { width = 32;
  base = 0x6a20c000;
  rd = 0:5;
}

op g_to_r { class = misc; encoding = G_TO_R;
  operands = rd: GPR;
  syntax = "{rd} = g0";
}

encoding R_TO_G { width = 32;
  base = 0x6200c000;
  rs1 = 16:5;
}

op r_to_g { class = misc; encoding = R_TO_G;
  operands = rs1: GPR;
  syntax = "g0 = {rs1}";
}
