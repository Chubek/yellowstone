# Linux eBPF. Every form is one little-endian 64-bit word with opcode:8, the
# # register byte (src:4 at bit 12, dst:4 at bit 8), off:16 at bit 16 and imm:32 at
# # bit 32. Unsuffixed operations take a source register and the 'i' forms a signed
# # 32-bit immediate. For the stx forms rd is the stored value and rs1 the address,
# # which is the register order the instruction set specification uses; llvm-mc spells
# # those forms with the two registers the other way round.
arch bpf { word_size = 64; addr_size = 64; endian = little; align = 8; }

regclass GPR {
    r0(64)=0,
    r1(64)=1,
    r2(64)=2,
    r3(64)=3,
    r4(64)=4,
    r5(64)=5,
    r6(64)=6,
    r7(64)=7,
    r8(64)=8,
    r9(64)=9,
    r10(64)=10,
}



encoding B_ADD64 { width = 64;
  base = 0xf;
  rd = 8:4;
  rs1 = 12:4;
  signed = 1;
}

op add64 { class = arithmetic; encoding = B_ADD64;
  operands = rd: GPR, rs1: GPR;
  syntax = "add64 {rd}, {rs1}";
}

encoding B_ADD64I { width = 64;
  base = 0x7;
  rd = 8:4;
  imm = 32:32;
  signed = 1;
}

op add64i { class = arithmetic; encoding = B_ADD64I;
  operands = rd: GPR, imm: imm;
  syntax = "add64 {rd}, {imm}";
}

encoding B_SUB64 { width = 64;
  base = 0x1f;
  rd = 8:4;
  rs1 = 12:4;
  signed = 1;
}

op sub64 { class = arithmetic; encoding = B_SUB64;
  operands = rd: GPR, rs1: GPR;
  syntax = "sub64 {rd}, {rs1}";
}

encoding B_SUB64I { width = 64;
  base = 0x17;
  rd = 8:4;
  imm = 32:32;
  signed = 1;
}

op sub64i { class = arithmetic; encoding = B_SUB64I;
  operands = rd: GPR, imm: imm;
  syntax = "sub64 {rd}, {imm}";
}

encoding B_MUL64 { width = 64;
  base = 0x2f;
