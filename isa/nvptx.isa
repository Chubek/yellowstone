# NVIDIA PTX virtual ISA: render assembly only; there is no target-independent
# machine byte form.  The encodings are text, so every operation renders the
# PTX source line that names it and nothing is encoded.
#
# The register file splits on width: r0 to r15 are 32-bit and rd0 to rd7 are
# 64-bit, so a 32-bit operation rejects a 64-bit register and the other way
# round is a caller error, the way PTX itself types its registers.  The _u32,
# _s32 and _b32 forms take the 32-bit half, _u64, _s64 and _b64 the 64-bit
# half, and the floating point forms take the f registers, with fd0 to fd7
# holding a 64-bit double.
arch nvptx { word_size = 32; addr_size = 64; endian = little; align = 1; }

regclass GPR {
    r0(32)=0,
    r1(32)=1,
    r2(32)=2,
    r3(32)=3,
    r4(32)=4,
    r5(32)=5,
    r6(32)=6,
    r7(32)=7,
    r8(32)=8,
    r9(32)=9,
    r10(32)=10,
    r11(32)=11,
    r12(32)=12,
    r13(32)=13,
    r14(32)=14,
    r15(32)=15,
    rd0(64)=16,
    rd1(64)=17,
    rd2(64)=18,
    rd3(64)=19,
    rd4(64)=20,
    rd5(64)=21,
    rd6(64)=22,
    rd7(64)=23,
}

regclass FPR {
    f0(32)=0,
    f1(32)=1,
    f2(32)=2,
    f3(32)=3,
    f4(32)=4,
    f5(32)=5,
    f6(32)=6,
    f7(32)=7,
    f8(32)=8,
    f9(32)=9,
    f10(32)=10,
    f11(32)=11,
    f12(32)=12,
    f13(32)=13,
    f14(32)=14,
    f15(32)=15,
    fd0(64)=16,
    fd1(64)=17,
    fd2(64)=18,
    fd3(64)=19,
    fd4(64)=20,
    fd5(64)=21,
    fd6(64)=22,
    fd7(64)=23,
}

# the 32-bit integer forms, which the loader restricts to the 32-bit registers
encoding ADD_U32 { width = text; }
op add_u32 { class = arithmetic; encoding = ADD_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "add.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding SUB_U32 { width = text; }
op sub_u32 { class = arithmetic; encoding = SUB_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "sub.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding MUL_LO_U32 { width = text; }
op mul_lo_u32 { class = arithmetic; encoding = MUL_LO_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "mul.lo.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding MUL_HI_U32 { width = text; }
op mul_hi_u32 { class = arithmetic; encoding = MUL_HI_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "mul.hi.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding DIV_U32 { width = text; }
op div_u32 { class = arithmetic; encoding = DIV_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "div.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding REM_U32 { width = text; }
op rem_u32 { class = arithmetic; encoding = REM_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "rem.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding AND_B32 { width = text; }
op and_b32 { class = arithmetic; encoding = AND_B32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "and.b32 %{rd}, %{rs1}, %{rs2};"; }

encoding OR_B32 { width = text; }
op or_b32 { class = arithmetic; encoding = OR_B32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "or.b32 %{rd}, %{rs1}, %{rs2};"; }

encoding XOR_B32 { width = text; }
op xor_b32 { class = arithmetic; encoding = XOR_B32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "xor.b32 %{rd}, %{rs1}, %{rs2};"; }

encoding NOT_B32 { width = text; }
op not_b32 { class = arithmetic; encoding = NOT_B32; operands = rd: GPR, rs1: GPR; syntax = "not.b32 %{rd}, %{rs1};"; }

encoding SHL_B32 { width = text; }
op shl_b32 { class = arithmetic; encoding = SHL_B32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "shl.b32 %{rd}, %{rs1}, %{rs2};"; }

encoding SHR_B32 { width = text; }
op shr_b32 { class = arithmetic; encoding = SHR_B32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "shr.b32 %{rd}, %{rs1}, %{rs2};"; }

encoding NEG_U32 { width = text; }
op neg_u32 { class = arithmetic; encoding = NEG_U32; operands = rd: GPR, rs1: GPR; syntax = "neg.u32 %{rd}, %{rs1};"; }

encoding MAD_LO_U32 { width = text; }
op mad_lo_u32 { class = arithmetic; encoding = MAD_LO_U32; operands = rd: GPR, rs1: GPR, rs2: GPR, rs3: GPR; syntax = "mad.lo.u32 %{rd}, %{rs1}, %{rs2}, %{rs3};"; }

encoding MOV_U32 { width = text; }
op mov_u32 { class = arithmetic; encoding = MOV_U32; operands = rd: GPR, rs1: GPR; syntax = "mov.u32 %{rd}, %{rs1};"; }

# the 32-bit signed and the 64-bit forms
encoding ADD_S32 { width = text; }
op add_s32 { class = arithmetic; encoding = ADD_S32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "add.s32 %{rd}, %{rs1}, %{rs2};"; }

encoding ADD_U64 { width = text; }
op add_u64 { class = arithmetic; encoding = ADD_U64; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "add.u64 %{rd}, %{rs1}, %{rs2};"; }

encoding SUB_U64 { width = text; }
op sub_u64 { class = arithmetic; encoding = SUB_U64; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "sub.u64 %{rd}, %{rs1}, %{rs2};"; }

encoding MUL_LO_U64 { width = text; }
op mul_lo_u64 { class = arithmetic; encoding = MUL_LO_U64; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "mul.lo.u64 %{rd}, %{rs1}, %{rs2};"; }

encoding MOV_U64 { width = text; }
op mov_u64 { class = arithmetic; encoding = MOV_U64; operands = rd: GPR, rs1: GPR; syntax = "mov.u64 %{rd}, %{rs1};"; }

# the floating point forms
encoding ADD_F32 { width = text; }
op add_f32 { class = arithmetic; encoding = ADD_F32; operands = rd: FPR, rs1: FPR, rs2: FPR; syntax = "add.f32 %{rd}, %{rs1}, %{rs2};"; }

encoding SUB_F32 { width = text; }
op sub_f32 { class = arithmetic; encoding = SUB_F32; operands = rd: FPR, rs1: FPR, rs2: FPR; syntax = "sub.f32 %{rd}, %{rs1}, %{rs2};"; }

encoding MUL_F32 { width = text; }
op mul_f32 { class = arithmetic; encoding = MUL_F32; operands = rd: FPR, rs1: FPR, rs2: FPR; syntax = "mul.f32 %{rd}, %{rs1}, %{rs2};"; }

encoding DIV_F32 { width = text; }
op div_f32 { class = arithmetic; encoding = DIV_F32; operands = rd: FPR, rs1: FPR, rs2: FPR; syntax = "div.f32 %{rd}, %{rs1}, %{rs2};"; }

encoding FMA_F32 { width = text; }
op fma_f32 { class = arithmetic; encoding = FMA_F32; operands = rd: FPR, rs1: FPR, rs2: FPR, rs3: FPR; syntax = "fma.rn.f32 %{rd}, %{rs1}, %{rs2}, %{rs3};"; }

encoding ADD_F64 { width = text; }
op add_f64 { class = arithmetic; encoding = ADD_F64; operands = rd: FPR, rs1: FPR, rs2: FPR; syntax = "add.f64 %{rd}, %{rs1}, %{rs2};"; }

encoding MUL_F64 { width = text; }
op mul_f64 { class = arithmetic; encoding = MUL_F64; operands = rd: FPR, rs1: FPR, rs2: FPR; syntax = "mul.f64 %{rd}, %{rs1}, %{rs2};"; }

encoding NEG_F32 { width = text; }
op neg_f32 { class = arithmetic; encoding = NEG_F32; operands = rd: FPR, rs1: FPR; syntax = "neg.f32 %{rd}, %{rs1};"; }

encoding MOV_F32 { width = text; }
op mov_f32 { class = arithmetic; encoding = MOV_F32; operands = rd: FPR, rs1: FPR; syntax = "mov.f32 %{rd}, %{rs1};"; }

# the conversions
encoding CVT_F32_U32 { width = text; }
op cvt_f32_u32 { class = arithmetic; encoding = CVT_F32_U32; operands = rd: FPR, rs1: GPR; syntax = "cvt.rn.f32.u32 %{rd}, %{rs1};"; }

encoding CVT_U32_F32 { width = text; }
op cvt_u32_f32 { class = arithmetic; encoding = CVT_U32_F32; operands = rd: GPR, rs1: FPR; syntax = "cvt.rzi.u32.f32 %{rd}, %{rs1};"; }

encoding CVT_F64_F32 { width = text; }
op cvt_f64_f32 { class = arithmetic; encoding = CVT_F64_F32; operands = rd: FPR, rs1: FPR; syntax = "cvt.f64.f32 %{rd}, %{rs1};"; }

encoding CVT_F32_F64 { width = text; }
op cvt_f32_f64 { class = arithmetic; encoding = CVT_F32_F64; operands = rd: FPR, rs1: FPR; syntax = "cvt.rn.f32.f64 %{rd}, %{rs1};"; }

# the predicate group
encoding SETP_EQ_U32 { width = text; }
op setp_eq_u32 { class = compare; encoding = SETP_EQ_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "setp.eq.u32 %{rd}, %{rs1}, %{rs2};"; }

encoding SETP_LT_S32 { width = text; }
op setp_lt_s32 { class = compare; encoding = SETP_LT_S32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "setp.lt.s32 %{rd}, %{rs1}, %{rs2};"; }

encoding SETP_GT_F32 { width = text; }
op setp_gt_f32 { class = compare; encoding = SETP_GT_F32; operands = rd: GPR, rs1: FPR, rs2: FPR; syntax = "setp.gt.f32 %{rd}, %{rs1}, %{rs2};"; }

encoding SELP_U32 { width = text; }
op selp_u32 { class = arithmetic; encoding = SELP_U32; operands = rd: GPR, rs1: GPR, rs2: GPR, rs3: GPR; syntax = "selp.u32 %{rd}, %{rs1}, %{rs2}, %{rs3};"; }

# the control group
encoding RET { width = text; }
op ret { class = branch; encoding = RET; operands = ; syntax = "ret;"; }

encoding BRA { width = text; }
op bra { class = branch; encoding = BRA; operands = target: rel; syntax = "bra {target};"; }

encoding CALL { width = text; }
op call { class = branch; encoding = CALL; operands = target: rel; syntax = "call {target};"; }

encoding EXIT { width = text; }
op exit { class = branch; encoding = EXIT; operands = ; syntax = "exit;"; }

encoding BAR_SYNC { width = text; }
op bar_sync { class = misc; encoding = BAR_SYNC; operands = imm: imm; syntax = "bar.sync {imm};"; }
