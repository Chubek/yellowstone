# AVR classic core, sixteen-bit instruction words stored little endian.  A
# register number is five bits, and only the two-register form splits them: the low
# four at 4:4 and the fifth at 8:1 for a destination, and the low four at 0:4
# with the fifth at 9:1 for a source.  Each half is a slice of the one register
# operand, which is what the hardware does.  Everywhere else the five bits are
# contiguous at 4:5.
# 
# The eight-bit constant of the immediate group sits either side of the register's
# low four, so the constant is what is split there.  The bit operations take a
# register and a three-bit bit number.  The data-pointer loads and stores take a
# register and a six-bit displacement whose low three bits sit below the register
# and whose top three sit in the middle of the word.  The pointer loads and stores
# take a register with the bits that name the pointer fixed per mnemonic, so the
# three pointer forms are three operations.
# 
# A relative jump stores a word count, not a byte count: rjmp and rcall take a
# twelve-bit one and the conditional branches a seven-bit one, so each is declared
# with a one-bit shift.
# 
# ser and cbr are one-register in the encoding: the upper half of the pattern they
# write is fixed, so only the register is a field.  clr is and with both operands
# the same register, so it is the two-register form and the two operands must be
# given the same register.  The signed multiply takes both registers as plain
# four-bit fields with no fifth bit, so it only describes r16 to r19: from r20 up
# the second register's fifth bit moves to a position that depends on the first
# register's number, and the format has no way to place a field at a computed
# position.
# 
# Not listed, with the reason: jmp and call, whose twenty-two-bit word count is
# split with the next bit in the first word's lowest bit and the top five in the
# middle of the same word, so no one shift describes the whole field; the word-pair
# add and subtract and movw, whose register operand is a seven-bit index into the
# register pairs rather than a register number; adiw and sbiw, whose register
# operand is a two-bit index into the four pointer pairs; the skip-if-bit-set
# forms, which this assembler does not accept; in and out, whose operand is an
# input register number that the assembler maps into the six-bit field by a rule
# the field value does not follow; and the floating point group, which this
# assembler does not accept.
arch avr { word_size = 8; addr_size = 16; endian = little; align = 2; }

regclass GPR {
    r0(8)=0,
    r1(8)=1,
    r2(8)=2,
    r3(8)=3,
    r4(8)=4,
    r5(8)=5,
    r6(8)=6,
    r7(8)=7,
    r8(8)=8,
    r9(8)=9,
    r10(8)=10,
    r11(8)=11,
    r12(8)=12,
    r13(8)=13,
    r14(8)=14,
    r15(8)=15,
    r16(8)=16,
    r17(8)=17,
    r18(8)=18,
    r19(8)=19,
    r20(8)=20,
    r21(8)=21,
    r22(8)=22,
    r23(8)=23,
    r24(8)=24,
    r25(8)=25,
    r26(8)=26,
    r27(8)=27,
    r28(8)=28,
    r29(8)=29,
    r30(8)=30,
    r31(8)=31,
}

alias xl = r26;
alias xh = r27;
alias yl = r28;
alias yh = r29;
alias zl = r30;
alias zh = r31;
alias sp = r5;



encoding ADD { width = 16;
  base = 0xc00;
  rd[3:0] = 4:4;
  rd[4:4] = 8:1;
  rs1[3:0] = 0:4;
  rs1[4:4] = 9:1;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR;
  syntax = "add {rd}, {rs1}";
}

encoding ADC { width = 16;
  base = 0x1c00;
  rd[3:0] = 4:4;
  rd[4:4] = 8:1;
  rs1[3:0] = 0:4;
  rs1[4:4] = 9:1;
}

op adc { class = arithmetic; encoding = ADC;
  operands = rd: GPR, rs1: GPR;
  syntax = "adc {rd}, {rs1}";
}

encoding SUB { width = 16;
  base = 0x1800;
  rd[3:0] = 4:4;
  rd[4:4] = 8:1;
  rs1[3:0] = 0:4;
  rs1[4:4] = 9:1;
}

op sub { class = arithmetic; encoding = SUB;
  operands = rd: GPR, rs1: GPR;
  syntax = "sub {rd}, {rs1}";
}

encoding SBC { width = 16;
