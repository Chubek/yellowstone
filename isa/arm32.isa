# A32 with the always condition (0xe) unless the mnemonic says otherwise.  Every
# instruction carries its condition in bits 28:32, so a conditioned operation is a
# separate mnemonic rather than a field; the fourteen conditional branches are
# listed as b_eq through b_le.  Mnemonic dots are written with underscores in
# operation names, so vadd.f32 is the operation vadd_f32 while its syntax
# still reads vadd.f32.
# The data processing frame has the destination at 12:16, the first source at 16:20
# and the second at 0:4, with an eight bit immediate in the same low bits;
# the multiply frame moves the destination to 16:20 and puts the second source at 0:4.
# The loads and stores take a twelve bit displacement at 0:12 or an offset
# register at 0:4.  Branch displacements are byte offsets stored in words,
# so a twenty four bit branch writes offset[25:2] and an eight bit one
# offset[9:2].  MOVW and MOVT split their sixteen bit constant either side of the
# destination, so each takes the value and the rotation as separate operands, and
# UDF splits its twelve bit constant around a fixed nibble in the same way.
# 
# Not listed, with the reason in each case: the halfword, signed and doubleword
# loads and stores, whose displacement is split around a fixed nibble so no field
# pair here can hold it; the single precision VFPv3 forms, whose register number A32
# splits across two bit fields; the down addressing mode, whose encoding holds
# the complement of the displacement; and push and pop, which the assembler gives a
# dedicated single-instruction encoding for a lone register rather than one
# register list form.
arch arm32 { word_size = 32; addr_size = 32; endian = little; align = 4; }

regclass GPR {
    r0(32)=0,
    r1(32)=1,
    r2(32)=2,
    r3(32)=3,
    r4(32)=4,
    r5(32)=5,
    r6(32)=6,
    r7(32)=7,
    r8(32)=8,
    r9(32)=9,
    r10(32)=10,
    r11(32)=11,
    r12(32)=12,
    r13(32)=13,
    r14(32)=14,
    r15(32)=15,
}

regclass FPR {
    s0(32)=0,
    s1(32)=1,
    s2(32)=2,
    s3(32)=3,
    s4(32)=4,
    s5(32)=5,
    s6(32)=6,
    s7(32)=7,
    s8(32)=8,
    s9(32)=9,
    s10(32)=10,
    s11(32)=11,
    s12(32)=12,
    s13(32)=13,
    s14(32)=14,
    s15(32)=15,
    s16(32)=16,
    s17(32)=17,
    s18(32)=18,
    s19(32)=19,
    s20(32)=20,
    s21(32)=21,
    s22(32)=22,
    s23(32)=23,
    s24(32)=24,
    s25(32)=25,
    s26(32)=26,
    s27(32)=27,
    s28(32)=28,
    s29(32)=29,
    s30(32)=30,
    s31(32)=31,
    d0(32)=32,
    d1(32)=33,
    d2(32)=34,
    d3(32)=35,
    d4(32)=36,
    d5(32)=37,
    d6(32)=38,
    d7(32)=39,
    d8(32)=40,
    d9(32)=41,
    d10(32)=42,
    d11(32)=43,
    d12(32)=44,
    d13(32)=45,
    d14(32)=46,
    d15(32)=47,
    q0(32)=48,
    q1(32)=49,
    q2(32)=50,
    q3(32)=51,
    q4(32)=52,
    q5(32)=53,
    q6(32)=54,
    q7(32)=55,
}

alias sp = r13;
alias lr = r14;
alias pc = r15;



encoding ADD { width = 32;
  base = 0xe0800000;
  rd = 12:4;
  rs1 = 16:4;
  rs2 = 0:4;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "add {rd}, {rs1}, {rs2}";
}

