# Infineon TriCore TC1.6.2, assembly-only: the encodings are text, so each form
# renders the mnemonic with its operands and nothing is encoded.  The data
# registers d0 to d15 and the address registers a0 to a15 share the register
# class, and the add, sub and mov forms the bundled tests drive are restricted
# to a data register, the way the instruction set types its operands.
#
# The load and store forms write the memory reference in TriCore's own order --
# base first, then an optional 10-bit word offset -- and the branch and call
# forms name their target directly, since there are no machine bytes to
# resolve a displacement against.
arch tricore { word_size = 32; addr_size = 32; endian = little; align = 2; }

regclass GPR {
    d0(32)=0,
    d1(32)=1,
    d2(32)=2,
    d3(32)=3,
    d4(32)=4,
    d5(32)=5,
    d6(32)=6,
    d7(32)=7,
    d8(32)=8,
    d9(32)=9,
    d10(32)=10,
    d11(32)=11,
    d12(32)=12,
    d13(32)=13,
    d14(32)=14,
    d15(32)=15,
    a0(32)=16,
    a1(32)=17,
    a2(32)=18,
    a3(32)=19,
    a4(32)=20,
    a5(32)=21,
    a6(32)=22,
    a7(32)=23,
    a8(32)=24,
    a9(32)=25,
    a10(32)=26,
    a11(32)=27,
    a12(32)=28,
    a13(32)=29,
    a14(32)=30,
    a15(32)=31,
}

# the data-register arithmetic group
encoding ADD { width = text; }
op add { class = arithmetic; encoding = ADD; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "add {rd}, {rs1}, {rs2}"; }

encoding SUB { width = text; }
op sub { class = arithmetic; encoding = SUB; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "sub {rd}, {rs1}, {rs2}"; }

encoding MUL { width = text; }
op mul { class = arithmetic; encoding = MUL; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "mul {rd}, {rs1}, {rs2}"; }

encoding DIV { width = text; }
op div { class = arithmetic; encoding = DIV; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "div {rd}, {rs1}, {rs2}"; }

encoding AND { width = text; }
op and { class = arithmetic; encoding = AND; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "and {rd}, {rs1}, {rs2}"; }

encoding OR { width = text; }
op or { class = arithmetic; encoding = OR; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "or {rd}, {rs1}, {rs2}"; }

encoding XOR { width = text; }
op xor { class = arithmetic; encoding = XOR; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "xor {rd}, {rs1}, {rs2}"; }

encoding NOT { width = text; }
op not { class = arithmetic; encoding = NOT; operands = rd: GPR, rs1: GPR; syntax = "not {rd}, {rs1}"; }

encoding SHL { width = text; }
op shl { class = arithmetic; encoding = SHL; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "shl {rd}, {rs1}, {rs2}"; }

encoding SHR { width = text; }
op shr { class = arithmetic; encoding = SHR; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "shr {rd}, {rs1}, {rs2}"; }

encoding SHA { width = text; }
op sha { class = arithmetic; encoding = SHA; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "sha {rd}, {rs1}, {rs2}"; }

# the saturating and the packed group
encoding ADDS { width = text; }
op adds { class = arithmetic; encoding = ADDS; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "adds {rd}, {rs1}, {rs2}"; }

encoding SUBS { width = text; }
op subs { class = arithmetic; encoding = SUBS; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "subs {rd}, {rs1}, {rs2}"; }

encoding ADDS_U { width = text; }
op adds_u { class = arithmetic; encoding = ADDS_U; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "adds.u {rd}, {rs1}, {rs2}"; }

encoding MAX { width = text; }
op max { class = arithmetic; encoding = MAX; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "max {rd}, {rs1}, {rs2}"; }

encoding MIN { width = text; }
op min { class = arithmetic; encoding = MIN; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "min {rd}, {rs1}, {rs2}"; }

# the immediate forms
encoding ADDI { width = text; }
op addi { class = arithmetic; encoding = ADDI; operands = rd: GPR, rs1: GPR, imm: imm; syntax = "addi {rd}, {rs1}, {imm}"; }

encoding SUBI { width = text; }
op subi { class = arithmetic; encoding = SUBI; operands = rd: GPR, rs1: GPR, imm: imm; syntax = "subi {rd}, {rs1}, {imm}"; }

# the move and the compare group
encoding MOV { width = text; }
op mov { class = arithmetic; encoding = MOV; operands = rd: GPR, rs1: GPR; syntax = "mov {rd}, {rs1}"; }

encoding MOVH { width = text; }
op movh { class = arithmetic; encoding = MOVH; operands = rd: GPR, imm: imm; syntax = "movh {rd}, {imm}"; }

encoding CMP { width = text; }
op cmp { class = compare; encoding = CMP; operands = rs1: GPR, rs2: GPR; syntax = "cmp {rs1}, {rs2}"; }

encoding LT { width = text; }
op lt { class = compare; encoding = LT; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "lt {rd}, {rs1}, {rs2}"; }

# the address and the memory group
encoding ADDA { width = text; }
op adda { class = arithmetic; encoding = ADDA; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "add.a {rd}, {rs1}, {rs2}"; }

encoding LD_W { width = text; }
op ld_w { class = load; encoding = LD_W; operands = rd: GPR, rs1: GPR, offset: imm; syntax = "ld.w {rd}, [{rs1}]{offset}"; }

encoding ST_W { width = text; }
op st_w { class = store; encoding = ST_W; operands = rs1: GPR, rs2: GPR, offset: imm; syntax = "st.w [{rs1}]{offset}, {rs2}"; }

# the control group
encoding J { width = text; }
op j { class = branch; encoding = J; operands = target: rel; syntax = "j {target}"; }

encoding CALL { width = text; }
op call { class = branch; encoding = CALL; operands = target: rel; syntax = "call {target}"; }

encoding JZ { width = text; }
op jz { class = branch; encoding = JZ; operands = rs1: GPR, target: rel; syntax = "jz {rs1}, {target}"; }

encoding JNZ { width = text; }
op jnz { class = branch; encoding = JNZ; operands = rs1: GPR, target: rel; syntax = "jnz {rs1}, {target}"; }

encoding RET { width = text; }
op ret { class = branch; encoding = RET; operands = ; syntax = "ret"; }

encoding NOP { width = text; }
op nop { class = misc; encoding = NOP; operands = ; syntax = "nop"; }
