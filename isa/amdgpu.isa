# AMD GCN gfx900, little endian, every instruction one 32-bit word and each group
# its own frame.  The scalar sources are seven or eight bits and the vector ones
# are a full byte, so a vector operand spans where a scalar one stops.
# The frames and their field positions, numbered from bit zero: SOP2 puts the
# destination at 16:7 with the sources at 0:8 and 8:8; SOP1 drops one source, so
# the destination is at 16:7 and the source at 0:8; SOPC has just the two sources
# at 0:8 and 8:8; SOPK puts the destination at 16:7 and a sixteen-bit immediate at
# 0:16; SOPP is a bare sixteen-bit immediate at 0:16; VOP1 puts the destination at
# 17:8 and the source at 0:8; and VOP2 adds a second eight-bit source at 9:8.  A
# vector source keeps the VGPR flag in its top bit, so its register number is the
# low eight bits and the flag stays in the base.
# An immediate replaces the source and carries the literal flag in its top bit, so
# the immediate forms are listed under the register form's name with _imm
# appended, and their base keeps the flag.
# Not listed, with the reason: the two-word VOP3 group, which packs three sources
# into a second word with a shared format rather than one field each; and the VOPC
# compare group, whose destination is a condition register (vcc, vccz, exec or
# scc) that the encoding names by a special value rather than by a register
# number, so no register operand describes it.  The 64-bit scalar forms are listed
# with their register pair spelled as the even register of the pair, since the
# pair occupies the same field as one source would.
arch amdgpu { word_size = 32; addr_size = 64; endian = little; align = 4; }

