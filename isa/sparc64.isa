# SPARC V9 integer and floating point register forms, big endian, with unshifted
# register operands.  The syntax template adds the % sigil the assembler expects.
# 
# Four formats, all 32 bits.  Format 1 puts a destination at 25:5 and a
# twenty-two-bit immediate at 0:22.  Format 2 puts a destination at 25:5, a first
# source at 14:5 and a thirteen-bit immediate at 0:13.  Format 3 puts a
# destination at 25:5, a first source at 14:5 and a second source in the low five
# bits of the thirteen-bit third field; the eight bits above that are sub-opcode
# bits and stay in the base.  Format 0 puts a twenty-two-bit displacement at
# 0:22.  The opcode, the sub-opcode, the format's immediate-select bit, the branch
# annul bit and the branch condition are all fixed per mnemonic and stay in the
# base.
# 
# A branch displacement is a word count in the low twenty-two bits, stored
# unshifted.
# 
# The sixteen branch conditions are listed as bn through bvc, in the order the
# condition field numbers them, and the annulling branch as ba_a.  The loads and
# stores each have two forms, register offset and immediate offset, and the
# immediate one is listed under the same name with _imm appended.
# 
# jmpl names its source in the first source field and leaves the
# immediate-select bit clear, so its low field is part of the base.  popc instead
# names its source in the low field and leaves the first source field clear, so
# the two are declared differently; the measurement is what puts them apart.
# 
# Not listed, with the reason: the shift-by-constant forms, which this assembler
# does not accept in any spelling, so only the shift-by-register forms sllx, srlx
# and srax are here; mov, which the assembler folds into an or with a one, so the
# register move is the or form and the zeroing move is clr; and the floating point
# loads and stores and the conversions, which this assembler does not accept.
arch sparc64 { word_size = 64; addr_size = 64; endian = big; align = 4; }

regclass GPR {
    g0(64)=0,
    g1(64)=1,
    g2(64)=2,
    g3(64)=3,
    g4(64)=4,
    g5(64)=5,
    g6(64)=6,
    g7(64)=7,
    o0(64)=8,
    o1(64)=9,
    o2(64)=10,
    o3(64)=11,
    o4(64)=12,
    o5(64)=13,
    o6(64)=14,
    o7(64)=15,
    l0(64)=16,
    l1(64)=17,
    l2(64)=18,
    l3(64)=19,
    l4(64)=20,
    l5(64)=21,
    l6(64)=22,
    l7(64)=23,
    i0(64)=24,
    i1(64)=25,
    i2(64)=26,
    i3(64)=27,
    i4(64)=28,
    i5(64)=29,
    i6(64)=30,
    i7(64)=31,
}

regclass FPR {
    f0(64)=0,
    f1(64)=1,
    f2(64)=2,
    f3(64)=3,
    f4(64)=4,
    f5(64)=5,
    f6(64)=6,
    f7(64)=7,
    f8(64)=8,
    f9(64)=9,
    f10(64)=10,
    f11(64)=11,
    f12(64)=12,
    f13(64)=13,
    f14(64)=14,
    f15(64)=15,
    f16(64)=16,
    f17(64)=17,
    f18(64)=18,
    f19(64)=19,
    f20(64)=20,
    f21(64)=21,
    f22(64)=22,
    f23(64)=23,
    f24(64)=24,
    f25(64)=25,
    f26(64)=26,
    f27(64)=27,
    f28(64)=28,
    f29(64)=29,
    f30(64)=30,
    f31(64)=31,
}

alias sp = o6;
alias fp = i6;



encoding ADD { width = 32;
  base = 0x80000000;
  rd = 25:5;
  rs1 = 14:5;
  rs2 = 0:5;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "add %{rs1}, %{rs2}, %{rd}";
}

