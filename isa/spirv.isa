# SPIR-V core instruction stream. Each form emits the instruction word (word count in

# bits 16:0, opcode in bits 30:16) followed by one word per emitted operand; the

# caller supplies the module header and keeps the result-id space consistent.

arch spirv { word_size = 32; addr_size = 32; endian = little; align = 4; }



regclass GPR {

}



encoding S_NOP { width = stream;
  base = 0x0;
  sequence = word(0x10000);
}

op nop { class = misc; encoding = S_NOP;
  operands = ;
  syntax = "OpNop";
}

encoding S_UNDEF { width = stream;
  base = 0x0;
  sequence = word(0x30001),word(type),word(result);
}

op undef { class = misc; encoding = S_UNDEF;
  operands = type: imm, result: imm;
  syntax = "OpUndef %{type} %{result}";
}

encoding S_SOURCE_CONTINUED { width = stream;
  base = 0x0;
  sequence = word(0x20002),word(text);
}

op source_continued { class = misc; encoding = S_SOURCE_CONTINUED;
  operands = text: imm;
  syntax = "OpSourceContinued {text}";
}

encoding S_SOURCE { width = stream;
  base = 0x0;
