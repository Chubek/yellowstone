# AMD64 instruction forms, little endian. Variable encodings describe legacy
# prefixes, REX.W, opcode bytes, register/ModR/M operands, memory operands,
# fixed-size immediates and rel32 displacements (relative to instruction end).
# In group encodings, an imm operand in the ModR/M reg position is a checked
# three-bit opcode selector. Only the explicitly listed forms are supported.
arch amd64 { word_size = 64; addr_size = 64; endian = little; align = 1; }

regclass GPR {
    rax(64)=0,
    rcx(64)=1,
    rdx(64)=2,
    rbx(64)=3,
    rsp(64)=4,
    rbp(64)=5,
    rsi(64)=6,
    rdi(64)=7,
    r8(64)=8,
    r9(64)=9,
    r10(64)=10,
    r11(64)=11,
    r12(64)=12,
    r13(64)=13,
    r14(64)=14,
    r15(64)=15,
}

regclass FPR {
    xmm0(128)=0,
    xmm1(128)=1,
    xmm2(128)=2,
    xmm3(128)=3,
    xmm4(128)=4,
    xmm5(128)=5,
    xmm6(128)=6,
    xmm7(128)=7,
    xmm8(128)=8,
    xmm9(128)=9,
    xmm10(128)=10,
    xmm11(128)=11,
    xmm12(128)=12,
    xmm13(128)=13,
    xmm14(128)=14,
    xmm15(128)=15,
}



encoding ADD { width = variable;
  opcode = 0x1;
  rex_w = 1;
  modrm = rs1, rd;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR;
  syntax = "add {rd}, {rs1}";
}

encoding OR { width = variable;
  opcode = 0x9;
  rex_w = 1;
  modrm = rs1, rd;
}

op or { class = arithmetic; encoding = OR;
  operands = rd: GPR, rs1: GPR;
  syntax = "or {rd}, {rs1}";
}

