# Integer JIT forms. Group encodings expose the 3-bit opcode extension as
# an immediate selector, not a physical register. shift_cl selectors 4/5/7
# mean SHL/SHR/SAR; unary64 selector 7 means signed IDIV.
encoding MOV_IMM64 { width = variable;
  opcode = 0xb8;
  rex_w = 1;
  opreg = rd;
  imm64 = imm;
}
op mov_imm { class = misc; encoding = MOV_IMM64;
  operands = rd: GPR, imm: imm;
  syntax = "mov {rd}, {imm}";
}
encoding SHIFT_CL64 { width = variable;
  opcode = 0xd3;
  rex_w = 1;
  modrm = selector, rd;
}
op shift_cl { class = arithmetic; encoding = SHIFT_CL64;
  operands = rd: GPR, selector: imm;
  syntax = "shift/{selector} {rd}, cl";
}
encoding UNARY64 { width = variable;
  opcode = 0xf7;
  rex_w = 1;
  modrm = selector, rd;
}
op unary64 { class = arithmetic; encoding = UNARY64;
  operands = rd: GPR, selector: imm;
  syntax = "unary/{selector} {rd}";
}
