# Motorola 68000, big endian, sixteen-bit instructions with the register and the
# address field at the bottom of the word.
# Nothing here is measured against a reference assembler: this llvm-mc build has
# no M68k target, so there is no assembler to measure with.  The encodings are
# transcribed from the M68000 Programmer's Reference Manual and cross-read against
# the M68k TableGen definitions in the LLVM source tree, which give the same
# layouts.  The one encoding the bundled test suites check is the golden move_l
# they already carried, which still holds.
# A destination that may be either a data or an address register takes six bits
# with the data bit in the top one, so a data register is 0 to 7 and an address
# register is 8 to 15.  An effective address is a three-bit mode above a three-bit
# register, and the mode is part of every encoding that has an address, so it is
# an operand of every such form: 0 is a data register, 1 an address register, 2
# address register indirect, 3 postincrement, 4 predecrement, 5 a sixteen-bit
# displacement, 6 an eight-bit displacement with an index register, 7 a sixteen-bit
# displacement with an index register, 8 an absolute word, 9 an absolute long, 10 a
# program-counter displacement, 11 and 12 a program-counter displacement with an
# index register, 13 a program-counter displacement with a sixteen-bit
# displacement, and 14 an immediate.  The mode is written after the register in a
# square bracket, which is where the manual puts the same three bits.
# The move is direction-agnostic in the encoding: the six-bit register field and
# the six-bit address field hold the two operands either way round, so the
# six-bit form writes the address first and is listed as move_b_ea, move_w_ea
# and move_l_ea.  The three-bit form takes two data registers and is the one
# named move_b, move_w and move_l.  The size codes are 1 for a byte, 3 for a
# word and 2 for a long, which is why the long move sits between the other two.
# The one-operand group addresses its register through the effective address, so
# it is the address field's register and not a separate data register.  The
# multiply and divide forms share one encoding: the word form uses address mode
# seven and the long form mode three.  The sixteen branch conditions and the
# sixteen set-on-condition instructions are listed by the letter the assembler
# uses, in the order the condition field numbers them.
# Not listed, with the reason: the immediate-to-register forms, where the 68000
# puts the sixteen-bit value of the word and long forms in a second word rather
# than in a wider field, so one operation cannot describe it; the word and long
# branch forms, which reach their sixteen and thirty-two bit displacements the same
# way, by writing a marker in the eight-bit field and following it with a second
# word; the shift and rotate group, whose size and direction codes this file would
# have to take on trust with no way to check them; movem, whose register mask is
# a reversed bit list in the load form and whose size bit sits inside the mask
# field in the store form, so neither direction has one plain mask operand; stop,
# trap and link, whose immediate or displacement is a second word rather than a
# wider field; and the bitfield and multiply-accumulate instructions of the 68020
# and above, which the base encoding has no room for.
arch m68k { word_size = 32; addr_size = 32; endian = big; align = 2; }

regclass GPR {
    d0(32)=0,
    d1(32)=1,
    d2(32)=2,
    d3(32)=3,
    d4(32)=4,
    d5(32)=5,
    d6(32)=6,
    d7(32)=7,
    a0(32)=8,
    a1(32)=9,
    a2(32)=10,
    a3(32)=11,
    a4(32)=12,
    a5(32)=13,
    a6(32)=14,
    a7(32)=15,
}

alias sp = a7;
alias usp = a6;
alias fp = a5;



encoding MOVE_B { width = 16;
  base = 0x1000;
  rd = 9:3;
  rs1 = 0:3;
}

op move_b { class = misc; encoding = MOVE_B;
  operands = rd: GPR, rs1: GPR;
  syntax = "move.b ${rs1}, ${rd}";
}

encoding MOVEX_B { width = 16;
  base = 0x1000;
  rd = 6:6;
  mode = 3:3;
  reg = 0:3;
}

op move_b_ea { class = misc; encoding = MOVEX_B;
  operands = rd: GPR, mode: imm, reg: GPR;
  syntax = "move.b ${reg} [{mode}], ${rd}";
}

encoding MOVE_W { width = 16;
  base = 0x3000;
  rd = 9:3;
  rs1 = 0:3;
}

op move_w { class = misc; encoding = MOVE_W;
